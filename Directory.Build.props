<Project>

  <!-- Shared by every project in the solution, rather than repeated ten times. -->
  <PropertyGroup>
    <!-- Each project keeps a hand-written Properties\AssemblyInfo.cs, and the plugins
         additionally compile Server\Properties\VersionInfo.cs as a link - VersionUpdate.exe
         rewrites that file on every build. Letting the SDK emit its own assembly attributes
         on top of those is a duplicate-attribute error, so it stays off. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- The server finds its plugins by scanning its own directory through MEF, so every
         assembly has to land flat in Output\bin_d / Output\bin_r exactly where the old
         non-SDK projects put it. Without this the SDK appends \net48\ to OutputPath. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

</Project>
