<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>X13.Periphery</RootNamespace>
    <AssemblyName>MQTT_SN</AssemblyName>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>..\..\Output\bin_d\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\..\Output\bin_r\</OutputPath>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- Version attributes are generated into the server's tree by the UpdateVersionInfo task and
       shared by every plugin, so each one compiles that single file as a link. -->
  <ItemGroup>
    <Compile Include="..\..\Server\Properties\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
  </ItemGroup>

  <!-- Block types of LPLC, imported by LP_Tree.ImportTypes the way PersistentStorage imports base.xst.
       LogicalName pins the resource name to the namespace (LP_Tree.TYPES_RESOURCE): derived from the
       folder it would be X13.Periphery.LPLC.LPLC.xst. -->
  <ItemGroup>
    <EmbeddedResource Include="LPLC\LPLC.xst" LogicalName="X13.LogramPLC.LPLC.xst" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Server\Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NiL.JS" Version="2.6.1722" />
  </ItemGroup>

  <!-- Framework assemblies outside the set the SDK references implicitly for net48. -->
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

</Project>
