  <i n='LPLC' m='{"attr":65}'>
    <i n='Binary' m='{"attr":65}'>
      <i n='bAND' s='{
        "hint": "LPLC bitwise AND of the connected inputs A..H, -1 if none is connected",
        "icon": "data:image/svg+xml;base64,",
        "willful": true,
        "LPLC": { "op": "&amp;", "in": [ "A", "B", "C", "D", "E", "F", "G", "H" ] },
        "manifest": { "type": "LPLC/Binary/bAND", "MQTT-SN": { "tag": "---" },
                      "LPLC": { "pos": { "top": 0, "left": 0 }, "in": { "A": 0, "B": 0 }, "out": { "Q": true }, "run": {} } },
        "mi": { "LPLC": { "mi": {
          "in": { "mi": {
            "A": { "default": 0 }, "B": { "default": 0 }, "C": { "default": 0 }, "D": { "default": 0 },
            "E": { "default": 0 }, "F": { "default": 0 }, "G": { "default": 0 }, "H": { "default": 0 } } },
          "out": { "mi": { "Q": { "default": true } } } } } }
      }' m='{"attr":69}' ver='0.5.2610.27001' />
      <i n='bNOT' s='{
