    <i n='TWI' m='{"attr":65}'>
      <i n='SCAN_BUS' s='{
        "hint": "Scan TWI addresses 0x08..0x77 on a Scan rising edge; return Scan to 0 to rearm. Addr retains the last found address, or -1 until the first hit. Found addresses are logged at Info. Requires a configured, exclusive bus and PrintF-capable firmware.",
        "icon": "data:image/svg+xml;base64,",
        "willful": true,
        "LPLC": { "args": [ "TwiNr" ], "in": [ "Scan" ],
          "src": "class SCAN_BUS {\n  constructor(TwiNr) {\n    this.Bus = TwiNr;\n    this.Address = 0;\n    this.Waiting = false;\n    this.PreviousScan = false;\n    this.Addr = new Int32(-1);\n  }\n  Tick(Scan) {\n    let trigger = Scan &amp;&amp; !this.PreviousScan;\n    this.PreviousScan = !!Scan;\n    if(this.Address == 0) {\n      if(!trigger) return;\n      this.Address = 0x08;\n    }\n    let status = TwiBusStatus(this.Bus);\n    if(!this.Waiting) {\n      if(status != 0) return;\n      TwiBusControl(this.Bus, this.Address);\n      this.Waiting = true;\n      return;\n    }\n    if((status &amp; 0xF000) == 0) return;\n    if((status &amp; 0xF000) == 0x1000 &amp;&amp; (status &amp; 0xFF) == this.Address) {\n      this.Addr = this.Address;\n      this.Report();\n    }\n    this.Waiting = false;\n    this.Address++;\n    if(this.Address > 0x77) this.Address = 0;\n  }\n  Report() {\n    PrintF(LOG_INFO, \"TWI%d addr=%d\\x00\", this.Bus, this.Addr);\n  }\n}" },
        "manifest": { "type": "LPLC/TWI/SCAN_BUS", "MQTT-SN": { "tag": "---" },
                      "LPLC": { "pos": { "top": 0, "left": 0 }, "args": { "TwiNr": 0 }, "in": { "Scan": 0 }, "out": { "Addr": true }, "run": {} } },
        "mi": { "LPLC": { "mi": {
          "args": { "mi": { "TwiNr": { "cdr": 1, "label": "TWI", "editor": "Integer", "default": 0, "choices": { "provider": "bus", "kind": "twi", "scope": "configured" } } } },
          "in": { "mi": { "Scan": { "default": 0 } } },
          "out": { "mi": { "Addr": { "default": true } } } } } }
      }' m='{"attr":69}' ver='0.5.2611.3003' />
    </i>
    <i n='TwiMaster' s='{
      "hint":"TWI Master: initializes SDA/SCL in the constructor; Tick is empty",
      "icon":"data:image/svg+xml;base64,",
       "LPLC":{"args":["SdaPin","SdaMode","SclPin","SclMode"],"in":[],
         "provides":[{"kind":"twi","numberArg":"TwiNr"}],
         "src":"class TwiMaster {\n  constructor(SdaPin, SdaMode, SclPin, SclMode) {\n    ConfigPin(SdaPin, SdaMode, 0);\n    ConfigPin(SclPin, SclMode, 0);\n  }\n  Tick() {}\n}"},
       "manifest":{"type":"LPLC/TwiMaster","MQTT-SN":{"tag":"---"},
                   "LPLC":{"pos":{"top":0,"left":0},"args":{},"in":{},"out":{},"run":{}}},
       "mi":{"LPLC":{"mi":{"args":{"mi":{
         "TwiNr":{"cdr":1,"label":"TWI","editor":"Integer","required":true,"choices":{"provider":"bus","kind":"twi","scope":"supported"}},
         "SdaPin":{"cdr":2,"label":"SDA","choices":{"provider":"pin","kind":"twi","busArg":"TwiNr","role":"SDA","excludeArg":"SclPin"}},
         "SclPin":{"cdr":3,"label":"SCL","choices":{"provider":"pin","kind":"twi","busArg":"TwiNr","role":"SCL","excludeArg":"SdaPin"}},
         "SdaMode":{"cdr":0,"readonly":true,"derive":{"provider":"bus-mode","kind":"twi","busArg":"TwiNr","role":"SDA"}},
         "SclMode":{"cdr":0,"readonly":true,"derive":{"provider":"bus-mode","kind":"twi","busArg":"TwiNr","role":"SCL"}}}}}}}
     }' m='{"attr":69}' ver='0.5.2610.27005' />
