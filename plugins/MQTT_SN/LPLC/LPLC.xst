      <i n='Trigger' s='{
        "hint": "LPLC flip-flop: R resets, otherwise S sets, otherwise a rising C edge samples D; Q starts at 0, NQ = !Q",
        "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxNiAxNiI+PHBhdGggZmlsbD0iI2UzZmZkYSIgZD0iTTAgMGgxNnYxNkgweiIvPjxwYXRoIGZpbGw9Im5vbmUiIHN0cm9rZT0iIzAwMCIgZD0iTTQgM2g4djEwSDR6IE0xIDVoM20tMyA2aDNtOC02aDNtLTMgNmgzIE00IDdsMiAxLTIgMSIvPjwvc3ZnPg==",
        "willful": true,
        "LPLC": { "src": "class Trigger {\n  constructor() {\n    this.Q = false;\n    this.NQ = true;\n    this.CO = false;\n  }\n  Tick(S, D, C, R) {\n    if(R) { this.Q = false; } else if(S) { this.Q = true; } else if(!this.CO &amp;&amp; C) { this.Q = !!D; }\n    this.CO = !!C;\n    this.NQ = !this.Q;\n  }\n}", "in": [ "S", "D", "C", "R" ] },
        "manifest": { "type": "LPLC/Binary/Trigger", "MQTT-SN": { "tag": "---" },
                      "LPLC": { "pos": { "top": 0, "left": 0 }, "in": { "S": 0, "D": 0, "C": 0, "R": 0 }, "out": { "Q": true, "NQ": true }, "run": {} } },
        "mi": { "LPLC": { "mi": {
          "in": { "mi": { "S": { "default": 0 }, "D": { "default": 0 }, "C": { "default": 0 }, "R": { "default": 0 } } },
          "out": { "mi": { "Q": { "default": true }, "NQ": { "default": true } } } } } }
      }' m='{"attr":69}' ver='0.5.2610.27002' />
    </i>
    <i n='SerialPort' s='{
      "hint":"Programmable UART: state is Tick(A..H), like Func. Use SendByte/PrintF and UartGetByte/UartBytesToRead with this.Port. Port is read-only. DE=-1 disables RS-485.",
      "icon":"data:image/svg+xml;base64,",
      "editor":"JS", "default":"", "willful":true,
      "LPLC":{"args":["Port","TxPin","TxMode","RxPin","RxMode","Baud","Format","DePin","DeMode"],
        "provides":[{"kind":"serial","numberArg":"Port"}]},
      "manifest":{"type":"LPLC/SerialPort","MQTT-SN":{"tag":"---"},"attr":4,
        "LPLC":{"pos":{"top":0,"left":0},"args":{"Baud":9600,"Format":0,"DePin":-1},
          "in":{"A":0},"out":{"Q":true},"run":{}}},
      "mi":{"LPLC":{"mi":{
        "args":{"mi":{
          "Port":{"cdr":1,"label":"UART","editor":"Integer","choices":{"provider":"bus","kind":"serial","scope":"supported"}},
          "TxPin":{"cdr":2,"label":"TX","choices":{"provider":"pin","kind":"serial","busArg":"Port","role":"TX","excludeArgs":["RxPin","DePin"]}},
          "RxPin":{"cdr":3,"label":"RX","choices":{"provider":"pin","kind":"serial","busArg":"Port","role":"RX","excludeArgs":["TxPin","DePin"]}},
          "Baud":{"cdr":4,"label":"Baud","editor":"Integer","default":9600,"min":1,"max":5000000,"option":{"provider":"bus-option","kind":"serial","busArg":"Port","role":"TX"}},
          "Format":{"cdr":5,"label":"Frame","editor":"Integer","default":0,"choices":{"provider":"bus-option","kind":"serial","busArg":"Port","role":"RX"}},
          "DePin":{"cdr":6,"label":"DE","default":-1,"choices":{"provider":"pin","kind":"serial","busArg":"Port","role":"DE","allowNone":true,"excludeArgs":["TxPin","RxPin"]}},
          "TxMode":{"cdr":0,"derive":{"provider":"bus-mode","kind":"serial","busArg":"Port","role":"TX"}},
          "RxMode":{"cdr":0,"derive":{"provider":"bus-mode","kind":"serial","busArg":"Port","role":"RX"}},
          "DeMode":{"cdr":0,"derive":{"provider":"bus-mode","kind":"serial","busArg":"Port","role":"DE","pinArg":"DePin"}}
        }},
        "in":{"mi":{"A":{"default":0},"B":{"default":0},"C":{"default":0},"D":{"default":0},"E":{"default":0},"F":{"default":0},"G":{"default":0},"H":{"default":0}}},
        "out":{"mi":{"Q":{"default":true}}}
      }}}
    }' m='{"attr":69}' ver='0.5.2611.3003' />
    <i n='Func' s='{
      "hint": "LPLC function: src is the body of Tick(A..H); the return value is output Q, every this.X field is an output too",
