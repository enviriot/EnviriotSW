<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>X13.PersistentStorage</RootNamespace>
    <AssemblyName>PersistentStorage</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>..\..\Output\bin_d\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\..\Output\bin_r\</OutputPath>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- Version attributes are generated into the server's tree by the UpdateVersionInfo task and
       shared by every plugin, so each one compiles that single file as a link. -->
  <ItemGroup>
    <Compile Include="..\..\Server\Properties\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Server\Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 5.0.20, а НЕ 5.0.21: в 5.0.21 переписан дисковый слой, и checkpoint падает с
         "ReadFull must read PAGE_SIZE bytes" - счётчик длины лога расходится с тем, что на диске
         (https://github.com/mbdavid/LiteDB/issues/2523). На Debian это видно сразу, под Windows
         реже. Стабильной версии новее нет: после 5.0.21 идут только 6.0.0-prerelease.
         Держать в согласии с Archivist. -->
    <PackageReference Include="LiteDB" Version="5.0.20" />
    <PackageReference Include="NiL.JS" Version="2.6.1722" />
  </ItemGroup>

  <!-- Framework assemblies outside the set the SDK references implicitly for net48. -->
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
