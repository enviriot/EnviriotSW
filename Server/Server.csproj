<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>X13</RootNamespace>
    <AssemblyName>enviriot</AssemblyName>
    <StartupObject>X13.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>logo48.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>..\Output\bin_d\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\Output\bin_r\</OutputPath>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- Was $(SolutionDir)VersionUpdate.exe $(ProjectDir): $(SolutionDir) is only defined when
       MSBuild is handed the .sln, and $(ProjectDir) is not populated until the SDK's targets
       are imported - i.e. after this body is evaluated - so both come from the reserved
       property now. Unquoted on purpose: VersionUpdate.exe rejects a path without the
       trailing separator, and a quoted trailing backslash would escape the quote for cmd. -->
  <PropertyGroup>
    <PreBuildEvent>$(MSBuildProjectDirectory)\..\VersionUpdate.exe $(MSBuildProjectDirectory)\ $(Configuration)</PreBuildEvent>
  </PropertyGroup>

  <!-- base.xst is the repository seed PersistentStorage pulls out of this assembly by
       manifest name ("X13.Repository.base.xst") when it starts against an empty database.
       The SDK's default globs file an unknown extension under None, so naming it here is
       what keeps it embedded - and the failure would only show up on a fresh install. -->
  <ItemGroup>
    <EmbeddedResource Include="Repository\base.xst" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NiL.JS" Version="2.6.1722" />
  </ItemGroup>

  <!-- Framework assemblies outside the set the SDK references implicitly for net48. -->
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

</Project>
