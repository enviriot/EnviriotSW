<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>X13</RootNamespace>
    <AssemblyName>enviriot</AssemblyName>
    <StartupObject>X13.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>logo48.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>..\Output\bin_d\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\Output\bin_r\</OutputPath>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- Generates Properties\VersionInfo.cs before every build. Was a PreBuildEvent calling
       VersionUpdate.exe, a committed binary with no source; the numbering it implemented now
       lives in the imported file as an inline task, where it can be read and changed. -->
  <Import Project="$(MSBuildProjectDirectory)\..\VersionUpdate.targets" />

  <!-- The generated file is listed by hand rather than left to the SDK's **\*.cs glob. The glob
       is evaluated when the project is loaded, and on a fresh clone - a CI checkout, above all -
       the file does not exist yet: the target that writes it has not run. The glob then matches
       nothing, and enviriot.exe compiles with no version attributes at all and reports 0.0.0.0,
       while the six plugins, evaluated after the server has already built, link it and get the
       real number. An explicit Include has no such timing: the item is the path, and the file
       only has to exist by the time csc runs. Remove first, or the two would collide as a
       duplicate Compile item on every build after the first. -->
  <ItemGroup>
    <Compile Remove="Properties\VersionInfo.cs" />
    <Compile Include="Properties\VersionInfo.cs" />
  </ItemGroup>

  <!-- base.xst is the repository seed PersistentStorage pulls out of this assembly by
       manifest name ("X13.Repository.base.xst") when it starts against an empty database.
       The SDK's default globs file an unknown extension under None, so naming it here is
       what keeps it embedded - and the failure would only show up on a fresh install. -->
  <ItemGroup>
    <EmbeddedResource Include="Repository\base.xst" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NiL.JS" Version="2.6.1722" />
  </ItemGroup>

  <!-- Framework assemblies outside the set the SDK references implicitly for net48. -->
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

</Project>
